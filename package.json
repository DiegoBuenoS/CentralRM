{
  "name": "central-rm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "packages/shared"
  ],
  "overrides": {
    "expo": "52.0.49",
    "react-native": "0.76.9",
    "expo-asset": "11.0.5",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@expo/cli": "0.22.28"
  },
  "scripts": {
    "dev": "npm run dev:full",
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace @central-rm/api",
    "dev:server": "npm run dev:api",
    "dev:full": "npm run dev:api & vite",
    "dev:mobile": "npm run start --workspace @central-rm/mobile",
    "dev:mobile:ios": "npm run ios --workspace @central-rm/mobile",
    "dev:mobile:android": "npm run android --workspace @central-rm/mobile",
    "dev:mobile:web": "npm run web --workspace @central-rm/mobile",
    "docker:up": "sh -c 'docker compose -f apps/api/docker-compose.yml up -d --build || docker-compose -f apps/api/docker-compose.yml up -d --build'",
    "docker:down": "sh -c 'docker compose -f apps/api/docker-compose.yml down || docker-compose -f apps/api/docker-compose.yml down'",
    "docker:logs": "sh -c 'docker compose -f apps/api/docker-compose.yml logs -f api postgres || docker-compose -f apps/api/docker-compose.yml logs -f api postgres'",
    "docker:up:prod": "sh -c 'docker compose -f apps/api/docker-compose.prod.yml up -d --build || docker-compose -f apps/api/docker-compose.prod.yml up -d --build'",
    "docker:down:prod": "sh -c 'docker compose -f apps/api/docker-compose.prod.yml down || docker-compose -f apps/api/docker-compose.prod.yml down'",
    "docker:logs:prod": "sh -c 'docker compose -f apps/api/docker-compose.prod.yml logs -f api postgres postgres-backup || docker-compose -f apps/api/docker-compose.prod.yml logs -f api postgres postgres-backup'",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.6",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.6"
  }
}
