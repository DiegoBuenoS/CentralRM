# API TOTVS RM (consumida pelo backend)
RM_API_BASE_URL=http://dbs.brazilsouth.cloudapp.azure.com:8051
RM_AUTH_USERS_PATH=/api/framework/v1/users
RM_CONSULTA_BASE_PATH=/api/framework/v1/consultaSQLServer/RealizaConsulta

# Contexto da aplicação (coligada/empresa)
VITE_CONTEXT=1

# Backend local para integrações
VITE_BACKEND_BASE_URL=http://localhost:8787

# Chave server-side da Google Routes API
GOOGLE_MAPS_API_KEY=

# Origem permitida no CORS do backend
FRONTEND_ORIGIN=http://localhost:5173

# Arquivo local para persistir configurações de integração
BACKEND_CONFIG_FILE=./server/runtime-config.json

# Arquivo local para persistir solicitações de viagem no backend
TRAVEL_REQUESTS_FILE=./server/travel-requests.json
