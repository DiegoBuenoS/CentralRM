NODE_ENV=production
PORT=8787
FRONTEND_ORIGIN=https://SEU_DOMINIO_WEB

# Banco (preferencialmente managed Postgres em produção)
DATABASE_URL=postgres://central_rm_user:central_rm_pass@SEU_HOST_POSTGRES:5432/central_rm
DATABASE_SSL=true

# Integrações
RM_API_BASE_URL=http://dbs.brazilsouth.cloudapp.azure.com:8051
RM_AUTH_USERS_PATH=/api/framework/v1/users
RM_CONSULTA_BASE_PATH=/api/framework/v1/consultaSQLServer/RealizaConsulta
GOOGLE_MAPS_API_KEY=
# Arquivo JSON opcional para segredos locais (não versionar)
BACKEND_SECRETS_FILE=./runtime-secrets.json

# Fallback JSON (apenas quando DATABASE_URL estiver vazio)
TRAVEL_REQUESTS_MAX=10000
