PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://central_rm_user:central_rm_pass@localhost:5432/central_rm
DATABASE_SSL=false

# RM backend
RM_API_BASE_URL=http://dbs.brazilsouth.cloudapp.azure.com:8051
RM_AUTH_USERS_PATH=/api/framework/v1/users
RM_CONSULTA_BASE_PATH=/api/framework/v1/consultaSQLServer/RealizaConsulta

# Google Maps (opcional)
GOOGLE_MAPS_API_KEY=
# Arquivo JSON opcional para segredos locais (não versionar)
BACKEND_SECRETS_FILE=./runtime-secrets.json

# Persistência local
# Usada quando DATABASE_URL não estiver configurada
TRAVEL_REQUESTS_MAX=10000
